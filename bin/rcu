#!/bin/bash
# Stable entry point. Resolve launcher symlink before loading runtime modules.
set -euo pipefail
entry="${BASH_SOURCE[0]}"
if [[ -L "$entry" ]]; then
  target="$(readlink "$entry")"
  if [[ "$target" == /* ]]; then entry="$target"; else entry="$(dirname "$entry")/$target"; fi
fi
RCU_ROOT="$(CDPATH='' cd -- "$(dirname "$entry")/.." && pwd -P)"
export RCU_ROOT
# shellcheck source=lib/core.sh
source "$RCU_ROOT/lib/core.sh"
# shellcheck source=lib/setup.sh
source "$RCU_ROOT/lib/setup.sh"
# shellcheck source=lib/network.sh
source "$RCU_ROOT/lib/network.sh"
# shellcheck source=lib/backends/utm.sh
source "$RCU_ROOT/lib/backends/utm.sh"
[[ "$(uname -s)" == Darwin || "${RCU_TEST:-0}" == 1 ]] || die 'Run rcu on macOS, not inside the Debian VM.'
case "${1:-}" in
  '')
    utm_start
    user_notice 'Gast-Terminal wird geöffnet. exit kehrt zu macOS zurück; die VM bleibt an.'
    ssh_terminal ;;
  help|--help|-h) [[ $# == 1 ]] || die 'Usage: rcu help'; show_help ;;
  --version) [[ $# == 1 ]] || die 'Usage: rcu --version'; cat "$RCU_ROOT/VERSION" ;;
  setup) shift; setup_profile "$@" ;;
  upload) shift; upload "$@" ;;
  download) shift; download "$@" ;;
  copy) shift; copy "$@" ;;
  update)
    [[ $# -eq 2 && -f "$2/install.sh" ]] || die 'Usage: rcu update <trusted-source-repository-directory>'
    exec /bin/bash "$2/install.sh" ;;
  rollback)
    [[ $# -eq 1 ]] || die 'Usage: rcu rollback'
    exec /bin/bash "$RCU_ROOT/installer/rollback.sh" ;;
  uninstall)
    [[ $# -eq 1 ]] || die 'Usage: rcu uninstall'
    exec /bin/bash "$RCU_ROOT/installer/uninstall.sh" ;;
  utm)
    shift
    [[ $# == 1 ]] || die 'Usage: rcu utm {start|connect|shell|stop|health|status}'
    case "${1:-}" in
      start) utm_start ;;
      connect) utm_connect ;;
      shell) utm_shell ;;
      stop) utm_stop ;;
      health) utm_health ;;
      status) utm_status ;;
      *) die 'Usage: rcu utm {start|connect|shell|stop|health|status}' ;;
    esac ;;
  *) die 'Usage: rcu {help|setup|upload|download|copy|update|rollback|uninstall|utm}' ;;
esac
