#!/bin/bash
# Invoked only by OpenSSH. Never return a secret for a host-key or MFA prompt.
set +x
set -euo pipefail
case "${1:-}" in *[Pp]assword:|*[Pp]assword:\ ) ;; *) exit 1 ;; esac
[[ "${RCU_KEYCHAIN_SERVICE:-}" =~ ^rcu\.vm\.[[:xdigit:]-]{36}$ ]] || exit 1
[[ "${RCU_KEYCHAIN_ACCOUNT:-}" =~ ^[a-zA-Z_][a-zA-Z0-9_.-]*\$?$ ]] || exit 1
exec /usr/bin/security find-generic-password -s "$RCU_KEYCHAIN_SERVICE" -a "$RCU_KEYCHAIN_ACCOUNT" -w
