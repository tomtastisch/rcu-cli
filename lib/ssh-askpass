#!/bin/bash
# Retrieve the VM password from macOS Keychain without exposing it in process lists.
# Called by ssh (via SSH_ASKPASS) with the prompt text on stdin.
# The actual password is never stored in a shell variable or written to a file.
set -euo pipefail
service="${RCU_KEYCHAIN_SERVICE:-}"
account="${RCU_KEYCHAIN_ACCOUNT:-}"
[[ -n "$service" && -n "$account" ]] || exit 1
if [[ "${RCU_TEST:-0}" == 1 ]]; then
  /usr/bin/security find-generic-password -a "$account" -s "$service" -w 2>/dev/null
else
  /usr/bin/security find-generic-password -a "$account" -s "$service" -w 2>/dev/null
fi
